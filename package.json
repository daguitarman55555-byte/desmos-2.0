{
  "name": "desmos2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desmos 2.0 — exact visual replica of the Desmos graphing calculator, upgraded where Desmos is lacking.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json"
  },
  "dependencies": {
    "jquery": "3.7.1",
    "mathquill": "0.10.1-a"
  },
  "overrides": {
    "jquery": "3.7.1"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
